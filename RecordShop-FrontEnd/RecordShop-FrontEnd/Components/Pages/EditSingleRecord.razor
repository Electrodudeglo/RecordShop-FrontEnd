@page "/records/edit/{Id:int}"
@rendermode InteractiveServer
@using RecordShop_FrontEnd.Components.UI
@using RecordShop_FrontEnd.Models
@using RecordShop_FrontEnd.Services
@inject NavigationManager Nav
@inject AuthService service
@inject RecordService recordService

@if(!_authChecked)
{
	<div class="container has-text-centered mt-4">
		<progress class="progress is-primary" max="100">Loading</progress>
	</div>
}
else if(_isAuthenticated)
{
	<div class="container is-max-tablet mt-4">
		<EditMusicDetails musicRecord="Model" OnSave="HandleSave" />
	</div>
}

else
{	
	<ErrorPage/>
}


@code {
	[Parameter]
	public MusicRecordModel Model { get; set; } = new();

	[Parameter]
	public int Id { get; set; }

	private bool _isAuthenticated = false;
	private bool _authChecked = false;


	protected override async Task OnInitializedAsync()
	{
		try
		{
			var response = await recordService.GetById(Id);

			Model = response ?? new();

		}
		catch (Exception e)
		{
			Console.WriteLine(e.Message);
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if(firstRender)
		{
			var token = await service.GetToken();
			_isAuthenticated = !string.IsNullOrWhiteSpace(token);
			_authChecked = true;
			StateHasChanged();
		}
	}

	private async Task HandleSave(MusicRecordModel updateRecord)
	{
		try
		{
			var success = await recordService.UpdateRecord(Id,updateRecord);
			if(success)
			{
				Nav.NavigateTo($"/records/view/{Model.Id}");
			}
		}
		catch(Exception e)
		{
			Console.WriteLine(e.Message);
		}
	}
}
