@page "/records/edit/{Id:int}"
@rendermode InteractiveServer
@using RecordShop_FrontEnd.Components.UI
@using RecordShop_FrontEnd.Models
@using RecordShop_FrontEnd.Services
@inject NavigationManager Nav
@inject AuthService service


@if(_isAuthenticated)
{		
	<div class="container is-max-tablet">
		<EditMusicDetails musicRecord="Model" OnSave="HandleSave" />
	</div>
}

else
{	
	<ErrorPage/>
}


@code {
	[Parameter]
	public MusicRecordModel Model { get; set; } = new();

	[Parameter]
	public int Id { get; set; }

	[Inject] public RecordService recordService { get; set; }

	private bool _isAuthenticated = false;
	

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var http = new HttpClient();
			var response = await http.GetFromJsonAsync<MusicRecordModel>($"http://localhost:5125/api/v1/records/{Id}");

			Model = response ?? new();

		}
		catch (Exception e)
		{
			Console.WriteLine(e.Message);
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if(firstRender)
		{
			var token = await service.GetToken();
			_isAuthenticated = !string.IsNullOrWhiteSpace(token);
			StateHasChanged();
		}
	}

	private async Task HandleSave(MusicRecordModel updateRecord)
	{
		try
		{
			var success = await recordService.UpdateRecord(Id,updateRecord);
			if(success)
			{
				Nav.NavigateTo($"/records/view/{Model.Id}");
			}
		}
		catch(Exception e)
		{
			Console.WriteLine(e.Message);
		}
	}
}
