@page "/records/auth"
@using RecordShop_FrontEnd.Components.UI
@using RecordShop_FrontEnd.Services
@using RecordShop_FrontEnd.Models
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject AuthService Auth

<LoginComponent OnSubmit="HandleLogin"/>




@code {

	public async Task<LoginResultEnum> HandleLogin(LoginRequestModel creds)
	{
		var result = await Auth.Login(creds);

		if(result == LoginResultEnum.Success)
		{
			Nav.NavigateTo("/", forceLoad: true);
		}

		return result;
	}
}
