@page "/records/auth"
@using RecordShop_FrontEnd.Components.UI


<LoginComponent OnSubmit="HandleLogin"/>




@code {
@using RecordShop_FrontEnd.Services
@using RecordShop_FrontEnd.Models
@rendermode InteractiveServer
@inject NavigationManager Nav

	[Inject] private AuthService Auth { get; set; }
	
	private async Task HandleLogin(LoginRequestModel creds)
	{
		var success = await Auth.Login(creds);

		if(success)
		{
			Console.WriteLine(Auth.GetToken());
			Nav.NavigateTo("/", forceLoad: true);
		}
		else
		{
			Console.WriteLine("Invalid Login");
		}
	}
}
