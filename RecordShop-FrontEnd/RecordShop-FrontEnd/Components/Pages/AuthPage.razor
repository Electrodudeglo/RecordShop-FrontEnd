@page "/records/auth"
@using RecordShop_FrontEnd.Components.UI


<LoginComponent OnSubmit="HandleLogin"/>




@code {
@using RecordShop_FrontEnd.Services
@using RecordShop_FrontEnd.Models
@rendermode InteractiveServer
@inject NavigationManager Nav

	[Inject] private AuthService? Auth { get; set; } = null;

	
	public async Task HandleLogin(LoginRequestModel creds)
	{

		bool result = await Auth.Login(creds);

		if(result)
		{
			Nav.NavigateTo("/", forceLoad: true);
		}
		else
		{
			throw new Exception("Invalid credentials");
		}
	}
}
