@page "/records/view/{Id:int}"

@if (_isLoading)
{
	<div class="container has-text-centered">
		<progress class="progress is-primary" max="100">Loading</progress>
		<p class="mt-3">Loading record...</p>
	</div>
}
else
{
	<div class="container is-max-tablet">
		<MusicCard records="Model" DeleteRequested="HandleDeleteRequest" />
	</div>
}



@code {
@using RecordShop_FrontEnd.Components.UI
@using RecordShop_FrontEnd.Models
@using RecordShop_FrontEnd.Services
@rendermode InteractiveServer
@inject NavigationManager Nav


	[Parameter]
	public MusicRecordModel Model { get; set; } = new();

	[Parameter]
	public int Id { get; set; }

	[Inject] public RecordService RecordService { get; set; }

	private bool _isLoading = true;
	private bool _hasLoaded = false;


	protected override async Task OnInitializedAsync()
	{
		_isLoading = true;
	}

protected override async Task OnAfterRenderAsync(bool firstRender)
{
	if (firstRender && !_hasLoaded)
	{	
		// await Task.Delay(1000);
		_hasLoaded = true;

		var http = new HttpClient();
		var response = await http.GetFromJsonAsync<MusicRecordModel>(
			$"http://localhost:5125/api/v1/records/{Id}");

		Model = response ?? new MusicRecordModel();
		_isLoading = false;

		await InvokeAsync(StateHasChanged);
	}
}


	private async Task HandleDeleteRequest()
	{
		var success = await RecordService.DeleteRecord(Id);	
		if(success)
		{
			Nav.NavigateTo("/");
		}	
	}


}
