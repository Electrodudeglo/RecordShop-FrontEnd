	@page "/records/view/{Id:int}"
	@using RecordShop_FrontEnd.Components.UI
	@using RecordShop_FrontEnd.Models
	@using RecordShop_FrontEnd.Services
	@rendermode InteractiveServer
	@inject NavigationManager Nav

	@if (_isLoading)
	{
		<div class="container has-text-centered">
			<progress class="progress is-primary" max="100">Loading</progress>
			<p class="mt-3">Loading record...</p>
		</div>
	}
	else
	{
		<div class="container is-max-tablet">
			<MusicCard records="Model" />
		</div>
	}


@code {

	[Parameter]
	public MusicRecordModel Model { get; set; } = new();

	[Parameter]
	public int Id { get; set; }

	private bool _isLoading = true;

	protected override async Task OnInitializedAsync()
	{

		try
		{
			var http = new HttpClient();
			var response = await http.GetFromJsonAsync<MusicRecordModel>($"http://localhost:5125/api/v1/records/{Id}");
			Model = response ?? new MusicRecordModel();
			_isLoading = false;
		}

		catch(Exception e)
		{
			Console.WriteLine(e.Message);
		}

	}

}
