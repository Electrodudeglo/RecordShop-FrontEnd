
<header class="ml-4 mr-4">
    <nav class="navbar mt-4 has-shadow" role="navigation" aria-label="main navigation">
        <div class="navbar-brand">
            <a class="navbar-item" href="/">
                <svg width="240"
                     height="120"
                     viewBox="0 0 240 120"
                     xmlns="http://www.w3.org/2000/svg">
                    <!-- White waveform with uneven heights -->
                    <rect x="10" y="70" width="8" height="20" rx="4" fill="white" />
                    <rect x="25" y="50" width="8" height="40" rx="4" fill="white" />
                    <rect x="40" y="30" width="8" height="60" rx="4" fill="white" />
                    <rect x="55" y="20" width="8" height="80" rx="4" fill="white" />
                    <rect x="70" y="10" width="8" height="100" rx="4" fill="white" />
                    <rect x="85" y="25" width="8" height="70" rx="4" fill="white" />
                    <rect x="100" y="40" width="8" height="50" rx="4" fill="white" />
                    <rect x="115" y="55" width="8" height="30" rx="4" fill="white" />
                    <rect x="130" y="35" width="8" height="60" rx="4" fill="white" />
                    <rect x="145" y="15" width="8" height="90" rx="4" fill="white" />
                    <rect x="160" y="25" width="8" height="70" rx="4" fill="white" />
                    <rect x="175" y="45" width="8" height="50" rx="4" fill="white" />
                    <rect x="190" y="60" width="8" height="30" rx="4" fill="white" />
                    <rect x="205" y="40" width="8" height="60" rx="4" fill="white" />
                    <rect x="220" y="55" width="8" height="40" rx="4" fill="white" />
                </svg>
                <div>
                    <h1>Waveform Music</h1>
                </div>
            </a>
            <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbarBasicExample">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </a>
        </div>
        <div id="navbarBasicExample" class="navbar-menu">
            <div class="navbar-end">
                <div class="navbar-item">
                    <div class="buttons">
                        @if(!IsLoggedIn)
                        {
                            <NavLink href="@("records/auth")">
                                <div class="button is-ghost">
                                    Log In
                                </div>
                            </NavLink>
                        }
                        else {
                        <button class="button is-ghost" @onclick="HandleLogout">                            
                            Log Out
                        </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>

@code {

    @using RecordShop_FrontEnd.Services
    @inject NavigationManager Nav
    @inject AuthService Auth
    @rendermode InteractiveServer

    public bool IsLoggedIn = false;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            var token = await Auth.GetToken();
            IsLoggedIn = !string.IsNullOrWhiteSpace(token);
            StateHasChanged();
        }
    }

    private async Task HandleLogout()
    {
        await Auth.Logout();
        IsLoggedIn = false;
	}

}
