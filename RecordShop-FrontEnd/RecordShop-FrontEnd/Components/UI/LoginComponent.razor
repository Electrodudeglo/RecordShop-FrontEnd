
<div class="section">
    <div class="container" style="max-width: 420px;">

        <div class="box">
            <h1 class="title is-4 has-text-centered">Login</h1>

            <div class="field">
                <label class="label">Email</label>
                <div class="control">
                    <InputText class="input has-text-centered" @bind-Value="userCreds.UserName" type="email" placeholder="Enter your email"/>
                       <div class="mx-3">
                           <p class="mb-5 has-text-centered has-text-danger">Invalid Email</p>
                       </div>
                </div>
            </div>

            <div class="field">
                <label class="label">Password</label>
                <div class="control">
                    <InputText class="input has-text-centered" @bind-Value="userCreds.Password" type="password" placeholder="Enter your password" />
                    <span class="icon is-small is-left">
                        <i class="fas fa-lock"></i>
                    </span>
                </div>
            </div>

            
            <div class="field mt-5">
                <button class="button is-primary is-fullwidth @(isLoading ? "is-loading" :"")" @onclick="SubmitCreds" disabled="@(isLoading)">
                    Login
                </button>
            </div>
            <div class="has-text-centered has-text-danger">
                @ErrorMessage
            </div>
        </div>

    </div>
</div>


@code {

@using RecordShop_FrontEnd.Models
@rendermode InteractiveServer

	[Parameter]
	public LoginRequestModel userCreds { get; set; } = new();

	[Parameter]
	public EventCallback<LoginRequestModel> OnSubmit { get; set; }

    private bool isLoading { get; set; } = false;

    private string ErrorMessage { get; set; } = String.Empty;

    private string ErrorEmail { get; set; } = String.Empty;

    private string ErrorPassword { get; set; } = String.Empty;


	private async Task SubmitCreds()
	{
        isLoading = true;
        
        if(string.IsNullOrWhiteSpace(userCreds.UserName))
        {
            ErrorMessage = "Email is empty";
            isLoading = false;
            return;
        }
        
        if (userCreds.UserName.Contains("@"))
        {
            ErrorMessage = "Email must be valid";
            isLoading = false;
            return;
        }

        if(string.IsNullOrWhiteSpace(userCreds.Password))
        {
            ErrorMessage = "Password is empty";
            isLoading = false;
            return;
        }

        await Task.Delay(800);

        try
        {
            await OnSubmit.InvokeAsync(userCreds);
        }
        catch(Exception e)
        {
            ErrorMessage = "Invalid Login Details"; 
        }
        finally
        {
            isLoading = false;
        }
    }

}
