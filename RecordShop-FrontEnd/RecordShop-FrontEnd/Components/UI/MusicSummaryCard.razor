
<NavLink href="@($"/records/{records.Id}")">
	<div class="box p-2 mb-4">
		<div>
			<img src="@records.Cover" alt="Alternate Text" height="50" width="50" />
		</div>
		<div>
			<p class="is-size-7 truncate">@records.RecordTitle</p>
		</div>
		<div>
			<p class="is-size-7">@records.Artists</p>
		</div>
	</div>
</NavLink>


@code {

@using RecordShop_FrontEnd.Models

	[Parameter]
	public MusicRecordModel records { get; set; } = new();

}
