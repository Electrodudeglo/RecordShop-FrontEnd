<div class="box">

	<div class="has-text-centered">
		<div class="mb-4">
			<img src=@musicRecord.Cover alt="Alternate Text" height="200" width="200" />
		</div>
		<div class="mb-3">
			<p>Update Album Title</p>
		</div>
		<div class="mb-4">
			<InputText class="input has-text-centered" @bind-Value="musicRecord.RecordTitle" />
		</div>
		<div class="mb-3">
			<p>Update Artist Name</p>
		</div>
		<div class="mb-4">
			<InputText class="input has-text-centered" @bind-Value="musicRecord.Artists"/>
		</div>
		<div class="mb-3">
			<p>Update Genre</p>
		</div>
		<div class="mb-4">
			<InputText class="input has-text-centered" @bind-Value="musicRecord.Genre"/>
		</div>
		<div class="mb-3">
			<p>Update Year Released</p>
		</div>
		<div class="mb-4">
			<InputText class="input has-text-centered" @bind-Value="musicRecord.ReleaseYear" />
		</div>
		<div class="mb-3">
			<p>stock?</p>
		</div>
		<div class="mb-4">
			<InputNumber class="input has-text-centered" @bind-Value="musicRecord.Stock"/>
		</div>

		<div>
			<button class="button" @onclick="SaveRecord">Update</button>
		</div>
	</div>
</div>


@code {

@using RecordShop_FrontEnd.Models


	[Parameter]
	public MusicRecordModel musicRecord { get; set; } = new();

	[Parameter]
	public EventCallback<MusicRecordModel> OnSave { get; set; }

	private async Task SaveRecord()
	{
		Console.WriteLine("heeloo");	
		await OnSave.InvokeAsync(musicRecord);
	}

}

