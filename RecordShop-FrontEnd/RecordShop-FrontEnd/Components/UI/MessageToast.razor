<div class="toast-container" style="position:fixed; top:20px; right:20px; z-index:9999;">
    @foreach (var toast in ToastService.Messages)
    {
        <div class="notification @GetCss(toast.Type)">
            <button class="delete" @onclick="() => Close(toast)"></button>
            @toast.Text
        </div>
    }
</div>

@code {
    @using RecordShop_FrontEnd
    @inject Interfaces.IToastService ToastService

    protected override void OnInitialized()
    {
        ToastService.OnChange += StateHasChanged;
    }

    private void Close(ToastMessageClass toast)
    {
        ToastService.Remove(toast);
    }

    private string GetCss(ToastEnum type) => type switch
    {
        ToastEnum.Success => "is-success",
        ToastEnum.Error => "is-danger",
        ToastEnum.Warning => "is-warning",
        ToastEnum.Info => "is-info",
        _ => "is-info"
    };
}
