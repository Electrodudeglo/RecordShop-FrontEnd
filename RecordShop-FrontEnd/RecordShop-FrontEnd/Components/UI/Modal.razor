@using RecordShop_FrontEnd.Models
<div class="modal is-active is-clipped">
    <div class="modal-background"></div>

    <div class="modal-content">
        <div class="box">
            <div class="content has-text-centered mb-5">
                <p class="title is-5 has-text-danger">
                    Are you sure you want to delete this item?
                </p>
                <p class="subtitle is-6">
                    This action cannot be undone.
                </p>
            </div>

            <div class="buttons is-centered">
                <button class="button is-danger" @onclick="ConfirmDelete">
                    Delete
                </button>

                <button class="button is-light" @onclick="Close">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    <button class="modal-close is-large"
            aria-label="close"
            >
    </button>
</div>

@code {

    [Parameter]
    public EventCallback<MusicRecordModel> Record { get; set; }

    [Parameter]
    public EventCallback OnConfirmDelete { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }


    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task ConfirmDelete()
    {
        await OnConfirmDelete.InvokeAsync();
    }


}
