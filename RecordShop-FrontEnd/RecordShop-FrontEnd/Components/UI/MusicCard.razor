
<div class="box">
    <div class="has-text-centered">

        <div class="mb-5">
            <img src="@records.Cover"
                 alt="Music Album Cover Picture"
                  height="300" width="300"
                  />
        </div>

        <div class="mb-4">
            <p class="is-size-3 has-text-weight-semibold">
                @records.RecordTitle
            </p>

            <p class="is-size-5">@records.Artists</p>

            <p class="tag is-info is-light mt-3">
                Released: @records.ReleaseYear
            </p>

            <p class="tag is-success is-light mt-2">
                Stock: @records.Stock
            </p>
        </div>

        <!-- Action Buttons -->
        <div class="buttons is-centered mt-5">
            <NavLink class="button is-dark" href="@($"/records/edit/{records.Id}")">
                Edit
            </NavLink>

            <button class="button is-danger"
                    @onclick="() => OnDelete(records.Id)">
                Delete
            </button>
        </div>

    </div>
</div>

@code {

@using RecordShop_FrontEnd.Models



	[Parameter]
	public MusicRecordModel records { get; set; } = new();

    [Parameter]
    public EventCallback<int> DeleteRequested { get; set; }

    private async Task OnDelete(int id)
    {
        await DeleteRequested.InvokeAsync(id);
    }

}
