@using RecordShop_FrontEnd.Models
@using RecordShop_FrontEnd.Services
@inject NavigationManager Nav
@inject AuthService AuthService

<div class="box">
    <div class="has-text-centered">

        <div class="mb-5">
            <img src="@records.Cover"
                 alt="Music Album Cover Picture"
                 height="300" width="300" />
        </div>

        <div class="mb-4">
            <p class="is-size-3 has-text-weight-semibold">
                @records.RecordTitle
            </p>

            <p class="is-size-5">@records.Artists</p>

            <p class="tag is-info is-light mt-3">
                Released: @records.ReleaseYear
            </p>

            <p class="tag is-success is-light mt-2">
                Stock: @records.Stock
            </p>
        </div>

        @if (_isAuthenticated)
        {
            <div class="buttons is-centered mt-5">
                <NavLink class="button is-dark" href="@($"/records/edit/{records.Id}")">
                    Edit
                </NavLink>

                <button class="button is-danger" @onclick="DisplayModal">
                    Delete
                </button>
            </div>
        }
    </div>
</div>

@if (_showModal)
{
    <Modal OnClose="HandleClose" OnConfirmDelete="ConfirmDelete" />
}

@code {
    [Inject] public RecordService RecordService { get; set; }

    [Parameter]
    public MusicRecordModel records { get; set; } = new();

    private bool _showModal = false;
    private bool _isAuthenticated = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Safe place to call JS (GetToken uses JS)
            var token = await AuthService.GetToken();
            _isAuthenticated = !string.IsNullOrWhiteSpace(token);
            StateHasChanged();
        }
    }

    private void DisplayModal()
    {
        _showModal = true;
    }

    private void HandleClose()
    {
        _showModal = false;
    }

    private async Task ConfirmDelete()
    {
        var success = await RecordService.DeleteRecord(records.Id);

        if (success)
        {
            Nav.NavigateTo("/");
            _showModal = false;
        }
    }
}
