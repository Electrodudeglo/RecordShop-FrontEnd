@using RecordShop_FrontEnd.Services
@rendermode InteractiveServer
@inject AuthService Auth
@inject DeezerService Deezer


<div class="container box mt-5" style="max-width: 420px">
	<div class="has-text-centered">		
		
		<fieldset disabled="@(disableInput)">
			<div class="mb-3">
				<p> Add Album Title</p>
			</div>
			<div class="mb-4">
				<input class="input has-text-centered" @bind-Value="AlbumTitle" @bind-Value:event="oninput" />
				<div class="">
					<p class="has-text-danger">@errorTitle</p>
				</div>
			</div>
			<div class="mb-3">
				<p> Add Artist Name</p>
			</div>
			<div class="mb-4">
				<input class="input has-text-centered" @bind-Value="ArtistName" @bind-Value:event="oninput" />
				<div class="">
					<p class="has-text-danger">@errorArtist</p>
				</div>
			</div>
		</fieldset>
		
		<div class="mb-5">	
			<button class="button is-primary @(isloading ? "is-loading" :"")" @onclick="CallDeezer" disabled="@(isloading)">
				Submit
			</button>
		</div>
	</div>	
</div>

@if (testAlbum != null)
{
    <div class="container" style="max-width: 260px;">
        <div class="card">
            <div class="card-image">
                <img src="@testAlbum.CoverXl" alt="@testAlbum.Title"/>
            </div>

            <div class="card-content">
                <p class="title is-6">@testAlbum.Title</p>
                <p class="subtitle is-7">@testAlbum.Artist.Name</p>

                <p><strong>Genre:</strong> @testAlbum.Genres.Data.FirstOrDefault()?.Name</p>
                <p><strong>Release Year:</strong> @testAlbum.Release_Date.Substring(0, 4)</p>

                <div class="mt-4 has-text-centered">
                    <button class="button is-success is-small" @onclick="ConfirmAlbum">
                        Confirm Album
                    </button>
                    <button class="button is-danger is-small ml-2" @onclick="RejectAlbum">
                        Not Correct
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@code {

    private DeezerAlbumDetails testAlbum = new DeezerAlbumDetails{
        Id = 123456,
        Title = "In Times New Roman...",
        Artist = new DeezerArtist
        {
            Name = "Queens of the Stone Age"
        },
        Release_Date = "2023-06-16",
        Genres = new DeezerGenreContainer
        {
            Data = new List<DeezerGenre>
        {
            new DeezerGenre { Name = "Rock" }
        }
        },
        Cover = "https://cdn-images.dzcdn.net/images/cover/2f1ec14d68a7a719526969cf8388e9c5/56x56-000000-80-0-0.jpg",
        CoverBig = "https://cdn-images.dzcdn.net/images/cover/2f1ec14d68a7a719526969cf8388e9c5/56x56-000000-80-0-0.jpg",
        CoverXl = "https://cdn-images.dzcdn.net/images/cover/2f1ec14d68a7a719526969cf8388e9c5/1000x1000-000000-80-0-0.jpg",
        Fans = 50000
    };


    private string _albumTitle = "";
    public string AlbumTitle {
        get => _albumTitle; 
        set
        {
            _albumTitle = value;
            if (!string.IsNullOrWhiteSpace(value)) errorTitle = "";
        } 
    }

    private string _artistName = "";
    public string ArtistName {
        get => _artistName;
        set
        {
            _artistName = value;
            if (!string.IsNullOrWhiteSpace(value)) errorArtist = "";
        }
    }


    private string errorTitle = String.Empty;
    private string errorArtist = String.Empty;



    private DeezerAlbumDetails? album;

    private bool disableInput = false;
    private bool isloading = false;

    private async Task CallDeezer()
    {

        isloading = true;

        if (string.IsNullOrWhiteSpace(AlbumTitle))
        {
            errorTitle = "Album Title Missing";
            isloading = false;
            return;

        }

        if(string.IsNullOrEmpty(ArtistName))
        {
            errorArtist = "Artist Name Missing";
            isloading = false;
            return;

        }

        disableInput = true;

        await Task.Delay(600);

        album = await Deezer.FindAlbumSync(AlbumTitle,ArtistName);

        if(album != null)
        {
            Console.WriteLine("Data is clean");
        }

        else
        {

        }

    }


    private void ConfirmAlbum()
    {
        Console.WriteLine("Album confirmed!");
    }

    private void RejectAlbum()
    {
        Console.WriteLine("Album rejected!");
    }


}

