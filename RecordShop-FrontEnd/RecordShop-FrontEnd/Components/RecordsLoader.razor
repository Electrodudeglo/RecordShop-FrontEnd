@using RecordShop_FrontEnd.Components.UI
@using RecordShop_FrontEnd.Models
@rendermode InteractiveServer

<div class="container is-max-tablet mt-4">

    <SearchBar SearchText="@searchTerms" SearchTextChanged="OnsearchChanged" />

    @if (isLoading)
    {
        <div class="container has-text-centered mt-4">
            <p>Loading...</p>
        </div>
    }
    else if (!filteredRecords.Any())
    {
        <div class="container has-text-centered mt-4">
            <p>@emptyPageMessage</p>
        </div>
    }
    else
    {
        <div class="grid mt-4">
            @foreach (var record in filteredRecords)
            {
                <MusicSummaryCard records="record" />
            }
        </div>
    }

</div>

@code {
    private List<MusicRecordModel> allRecords { get; set; } = new();
    private List<MusicRecordModel> filteredRecords { get; set; } = new();

    private bool isLoading = true;
    private string emptyPageMessage = "";

    private string _searchTerms = "";
    private string searchTerms
    {
        get => _searchTerms;
        set
        {
            _searchTerms = value;
            FilterAlbums();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = new HttpClient();
            var response = await http.GetFromJsonAsync<List<MusicRecordModel>>(
                "http://localhost:5125/api/v1/records");

            allRecords = response ?? new List<MusicRecordModel>();
            filteredRecords = allRecords;

            emptyPageMessage = "No records found.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterAlbums()
    {
        if (string.IsNullOrWhiteSpace(searchTerms))
        {
            filteredRecords = allRecords;
        }
        else
        {
            filteredRecords = allRecords
                .Where(r => r.RecordTitle.Contains(searchTerms, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        emptyPageMessage = "No records match your search.";
    }

    private void OnsearchChanged(string value)
    {
        searchTerms = value;
    }
}
